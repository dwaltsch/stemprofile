{
  "name": "StemProfile: elevation stickers for your bike",
  "short_name": "StemProfile",
  "description": "Turn any GPX, TCX or FIT file into a printable, race-ready elevation sticker. Works offline; your route never leaves your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/gpx+xml": [".gpx"],
        "application/vnd.garmin.tcx+xml": [".tcx"],
        "application/vnd.ant.fit": [".fit"]
      }
    }
  ]
}
